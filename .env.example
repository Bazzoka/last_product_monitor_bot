# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=recipient@example.com

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Proxy Configuration (Optional)
USE_PROXY=false
PROXY_HTTP=http://proxy.example.com:8080
PROXY_HTTPS=https://proxy.example.com:8080

# Database (MariaDB/MySQL via XAMPP) — set STORAGE_BACKEND=mysql to force DB
STORAGE_BACKEND=auto
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bot
DB_USER=root
DB_PASSWORD=

# Dashboard Authentication (used to seed admins table on first run)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change_this_password
DASHBOARD_SECRET_KEY=generate_a_random_secret_key
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080

# Monitoring Settings
CHECK_INTERVAL_HOURS=1
MAX_RETRIES=3
REQUEST_TIMEOUT=30
MAX_CONCURRENT_CHECKS=10
LOW_STOCK_THRESHOLD=5
HEADLESS_BROWSER=true
